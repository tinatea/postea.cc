---
import Base from '../layouts/Base.astro';
---

<Base title="找不到頁面" description="這頁不存在。回到香語所首頁或活動行事曆。">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">404</p>
      <h1>這頁不在這裡</h1>
      <p class="lede">連結可能換過了。可以回首頁，或直接看活動行事曆。</p>
      <div class="hero-actions">
        <a class="button" href="/">回首頁</a>
        <a class="button-ghost" href="/events">活動行事曆</a>
      </div>
    </header>
  </div>
</Base>
