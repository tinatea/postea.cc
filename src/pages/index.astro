---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { splitEvents, taipeiToday } from '../lib/classify.mjs';
import { loadEvents, loadSite } from '../lib/load';

const site = loadSite();
const { upcoming } = splitEvents(await loadEvents(), taipeiToday());
const next = upcoming[0];
const comma = site.tagline.indexOf('，');
const titleLead = comma === -1 ? site.tagline : site.tagline.slice(0, comma);
const titleRest = comma === -1 ? '' : site.tagline.slice(comma + 1);
---

<Base title="首頁" description={site.bio} home>
  <section class="hero">
    <div class="wrap">
      <p class="kicker">台北 · 調香工作室</p>
      <div class="hero-layout">
        <div>
          <h1>
            {titleLead}，{titleRest && <><br />{titleRest}</>}
          </h1>
          <p class="bio">{site.bio}</p>
          <div class="hero-actions">
            <a class="button" href="#next">下一場活動</a>
            <a class="button-ghost" href={site.instagram} rel="noopener noreferrer">Instagram</a>
          </div>
        </div>
        <figure class="placeholder">
          <img
            src="/images/placeholders/studio-rack.jpg"
            width="288"
            height="216"
            alt="木架上排著琥珀色的滴管香油瓶。暫用圖片，裁自 Instagram 截圖。"
          />
          <figcaption>TODO：暫用照片，裁自 Instagram 截圖，請換成原始檔。</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="wrap" id="next">
    {
      next ? (
        <EventCard event={next} featured />
      ) : (
        <p class="empty">目前沒有即將舉行的活動。新的場次會出現在這裡。</p>
      )
    }
  </section>

  <section class="wrap">
    <h2 class="sr-only">其他頁面</h2>
    <div class="paths">
      <a class="path" href="/experiences">
        <strong>課程與體驗</strong>
        <span>自己調一瓶，或把已經調好的香帶回家。</span>
      </a>
      <a class="path" href="/recaps">
        <strong>活動紀錄</strong>
        <span>每場結束後的照片與文字。</span>
      </a>
      <a class="path" href="/posters">
        <strong>文宣</strong>
        <span>主視覺與海報，可以下載。</span>
      </a>
    </div>
  </section>
</Base>
