---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { splitEvents, taipeiToday } from '../lib/classify.mjs';
import { loadEvents } from '../lib/load';

const today = taipeiToday();
const { upcoming, past } = splitEvents(await loadEvents(), today);
---

<Base
  title="活動行事曆"
  description="Postéa 香語所的調香小聚。看日期、地點、費用與報名。還沒開放的場次會標示報名即將開放。"
>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">行事曆</p>
      <h1>活動行事曆</h1>
      <p class="lede">選一場坐下來。從同一個主題出發，調成自己的那一瓶。</p>
    </header>

    <section>
      <div class="section-head">
        <h2>即將舉行</h2>
      </div>
      {
        upcoming.length > 0 ? (
          upcoming.map((event) => <EventCard event={event} />)
        ) : (
          <p class="empty">目前沒有即將舉行的活動。</p>
        )
      }
    </section>

    <section>
      <div class="section-head">
        <h2>過往活動</h2>
      </div>
      {
        past.length > 0 ? (
          past.map((event) => <EventCard event={event} past />)
        ) : (
          <p class="empty">結束的場次會留在這裡。</p>
        )
      }
    </section>
  </div>
</Base>
