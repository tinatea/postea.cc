---
import Base from '../../layouts/Base.astro';
import CalendarMonth from '../../components/CalendarMonth.astro';
import Offerings from '../../components/Offerings.astro';
import { monthsToBuild, parseMonth } from '../../lib/calendar.mjs';
import { taipeiToday } from '../../lib/classify.mjs';
import { loadEvents } from '../../lib/load';
import type { WorkshopEvent } from '../../lib/types';

export async function getStaticPaths() {
  const events = await loadEvents();
  const today = taipeiToday();
  return monthsToBuild(events, today).map((key: string) => ({
    params: { month: key },
    props: { events, today },
  }));
}

interface Props {
  events: WorkshopEvent[];
  today: string;
}

const { events, today } = Astro.props;
const parsed = parseMonth(Astro.params.month ?? '');
if (!parsed) throw new Error(`無法讀取月份：${Astro.params.month}`);
const { year, month } = parsed;
---

<Base
  title={`${year}年${month}月`}
  description={`Postèa 香語所 ${year}年${month}月的活動。看日期、地點、費用與報名。`}
>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">月曆</p>
      <h1>月曆</h1>
      <p class="lede">
        這裡的場次是每月主題小聚：一群人跟著主題玩香。想一個人自由調香，看課程與體驗的香遇。
      </p>
    </header>

    <CalendarMonth events={events} today={today} year={year} month={month} />
    <Offerings />
  </div>
</Base>
