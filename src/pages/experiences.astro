---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { loadOfferings } from '../lib/load';

const { explore, gathering, choose } = loadOfferings();

function external(href: string) {
  return /^https?:\/\//i.test(href);
}
---

<Base
  title="課程與體驗"
  description="調香探索與體驗：一對一 NT$2,000，兩人同行每人 NT$1,800，三至四人同行每人 NT$1,600。每月主題調香：每人 NT$800。"
>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">課程</p>
      <h1>課程與體驗</h1>
    </header>

    <div class="course-list">
      <article class="stamp course-card">
        <h2 class="course-title">{explore.title}</h2>
        {explore.subtitle && <p class="course-sub">{explore.subtitle}</p>}
        {explore.body && <p class="course-body">{explore.body}</p>}
        {
          explore.prices.length > 0 && (
            <ul class="course-prices">
              {explore.prices.map((price) => (
                <li>{price}</li>
              ))}
            </ul>
          )
        }
        <dl class="course-facts">
          {explore.duration && (
            <div>
              <dt>時長</dt>
              <dd>{explore.duration}</dd>
            </div>
          )}
          {explore.takeHome && (
            <div>
              <dt>成品</dt>
              <dd>{explore.takeHome}</dd>
            </div>
          )}
        </dl>
        {
          explore.cta && explore.href && (
            <a
              class="button"
              href={explore.href}
              target={external(explore.href) ? '_blank' : undefined}
              rel={external(explore.href) ? 'noopener noreferrer' : undefined}
            >
              {explore.cta}
            </a>
          )
        }
      </article>

      <article class="stamp course-card">
        <h2 class="course-title">{gathering.title}</h2>
        {gathering.subtitle && <p class="course-sub">{gathering.subtitle}</p>}
        {gathering.body && <p class="course-body">{gathering.body}</p>}
        {
          gathering.prices.length > 0 && (
            <ul class="course-prices">
              {gathering.prices.map((price) => (
                <li>{price}</li>
              ))}
            </ul>
          )
        }
        {
          gathering.takeHome && (
            <dl class="course-facts">
              <div>
                <dt>成品</dt>
                <dd>{gathering.takeHome}</dd>
              </div>
            </dl>
          )
        }
        {
          gathering.cta && gathering.href && (
            <a class="button" href={gathering.href}>
              <Icon name="calendar-blank" />
              {gathering.cta}
            </a>
          )
        }
      </article>
    </div>

    <section class="stamp choose" aria-labelledby="choose-title">
      <h2 id="choose-title">{choose.title}</h2>
      {choose.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <figure class="placeholder">
      <img
        src="/images/placeholders/studio-table.jpg"
        width="288"
        height="228"
        alt="工作桌上的滴管瓶與深色玻璃瓶。暫用圖片，裁自 Instagram 截圖。"
        loading="lazy"
      />
      <figcaption>TODO：暫用照片，裁自 Instagram 截圖，請換成原始檔。</figcaption>
    </figure>
  </div>
</Base>
