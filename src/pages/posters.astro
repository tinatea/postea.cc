---
import Base from '../layouts/Base.astro';
import { loadPosters } from '../lib/load';

const posters = loadPosters();
---

<Base title="文宣" description="香語所的主視覺與活動海報，可下載。">
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">下載</p>
      <h1>文宣</h1>
      <p class="lede">主視覺與海報放在這裡，需要的時候可以直接下載。</p>
    </header>

    {
      posters.length === 0 ? (
        <p class="empty">文宣還在準備。主視覺與海報完成後，會放在這裡供下載。</p>
      ) : (
        <div class="stack">
          {posters.map((poster) => (
            <article class="stamp poster-card">
              <h2>{poster.title}</h2>
              {poster.note && <p>{poster.note}</p>}
              <img src={poster.file} alt={poster.title} loading="lazy" />
              <a class="button" href={poster.file} download>
                下載
              </a>
            </article>
          ))}
        </div>
      )
    }
  </div>
</Base>
