---
import Icon from './Icon.astro';
import { formatEventDate } from '../lib/classify.mjs';
import { compactTime } from '../lib/schedule.mjs';
import { resolveSignup } from '../lib/signup.mjs';
import EventArt from './EventArt.astro';
import SignupActions from './SignupActions.astro';
import { themeArt } from '../lib/theme-art.mjs';
import {
  buildMonthGrid,
  eventsInMonth,
  monthHref,
  monthKey,
  shiftMonth,
  shortEventName,
  monthsToBuild,
} from '../lib/calendar.mjs';
import type { WorkshopEvent } from '../lib/types';

interface Props {
  events: WorkshopEvent[];
  today: string;
  year: number;
  month: number;
}

const { events, today, year, month } = Astro.props;
const key = monthKey(year, month);
const monthEvents = eventsInMonth(events, key) as WorkshopEvent[];
const grid = buildMonthGrid(year, month);
const weeks: (number | null)[][] = [];
for (let index = 0; index < grid.length; index += 7) weeks.push(grid.slice(index, index + 7));
const byDay = new Map<number, WorkshopEvent[]>();
for (const event of monthEvents) {
  const day = Number(event.date.slice(8, 10));
  const list = byDay.get(day) ?? [];
  list.push(event);
  byDay.set(day, list);
}
const todayDay = today.startsWith(`${key}-`) ? Number(today.slice(8, 10)) : 0;
const weekdays = ['日', '一', '二', '三', '四', '五', '六'];
const prev = shiftMonth(year, month, -1);
const next = shiftMonth(year, month, 1);
const builtMonths = new Set(monthsToBuild(events, today));
const prevKey = monthKey(prev.year, prev.month);
const nextKey = monthKey(next.year, next.month);
const pillOnTheme = 'var(--theme-ink)';
const pillOnSage = '#ffffff';
---

<section class="stamp calendar-card" aria-label={`${year}年${month}月`}>
  <div class="month-bar">
    {
      builtMonths.has(prevKey) ? (
        <a class="month-switch" href={monthHref(prevKey)} aria-label="上個月">
          <Icon name="caret-left" />
        </a>
      ) : (
        <span class="month-switch is-disabled" aria-hidden="true">
          <Icon name="caret-left" />
        </span>
      )
    }
    <h2>{year}年{month}月</h2>
    {
      builtMonths.has(nextKey) ? (
        <a class="month-switch" href={monthHref(nextKey)} aria-label="下個月">
          <Icon name="caret-right" />
        </a>
      ) : (
        <span class="month-switch is-disabled" aria-hidden="true">
          <Icon name="caret-right" />
        </span>
      )
    }
  </div>
  <table class="cal">
    <thead>
      <tr>
        {weekdays.map((label) => <th scope="col">{label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        weeks.map((week) => (
          <tr>
            {week.map((day) => {
              const dayEvents = day ? (byDay.get(day) ?? []) : [];
              return (
                <td>
                  {day && dayEvents.length === 1 && (
                    <a
                      class:list={['cal-day', { 'is-today': day === todayDay }]}
                      href={`/events/${dayEvents[0].id}/`}
                    >
                      <span class="cal-num">
                        {day}
                        {day === todayDay && <span class="sr-only">（今天）</span>}
                      </span>
                      <span class="cal-mark">
                        <span
                          class="cal-pill"
                          style={`background:${dayEvents[0].accentColor || 'var(--color-sage)'};color:${dayEvents[0].accentColor ? pillOnTheme : pillOnSage}`}
                        >
                          {shortEventName(dayEvents[0].title)}
                        </span>
                        <span
                          class="cal-dot"
                          style={`background:${dayEvents[0].accentColor || 'var(--color-sage)'}`}
                          aria-hidden="true"
                        />
                        <span class="sr-only">{shortEventName(dayEvents[0].title)}，查看活動</span>
                      </span>
                    </a>
                  )}
                  {day && dayEvents.length !== 1 && (
                    <div class:list={['cal-day', { 'is-today': day === todayDay }]}>
                      <span class="cal-num">
                        {day}
                        {day === todayDay && <span class="sr-only">（今天）</span>}
                      </span>
                      {dayEvents.map((event) => (
                        <a class="cal-mark" href={`/events/${event.id}/`}>
                          <span
                            class="cal-pill"
                            style={`background:${event.accentColor || 'var(--color-sage)'};color:${event.accentColor ? pillOnTheme : pillOnSage}`}
                          >
                            {shortEventName(event.title)}
                          </span>
                          <span
                            class="cal-dot"
                            style={`background:${event.accentColor || 'var(--color-sage)'}`}
                            aria-hidden="true"
                          />
                          <span class="sr-only">{shortEventName(event.title)}，查看活動</span>
                        </a>
                      ))}
                    </div>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<section class="month-list" aria-labelledby="month-list-title">
  <div class="section-head">
    <h2 id="month-list-title">本月活動</h2>
  </div>
  {
    monthEvents.length === 0 ? (
      <p class="empty">這個月還沒有安排活動。</p>
    ) : (
      monthEvents.map((event) => {
        const time = compactTime(event);
        const signup = resolveSignup(event);
        const art = themeArt(event);
        const [, monthNumber, dayNumber] = event.date.split('-');
        return (
          <article class="month-item" id={event.id}>
            {
              art?.simple || art?.custom ? (
                <EventArt event={event} kind="stamp" />
              ) : (
                <div class="stamp date-stamp" aria-hidden="true">
                  <span class="date-stamp-mon">{Number(monthNumber)}月</span>
                  <span class="date-stamp-day">{Number(dayNumber)}</span>
                </div>
              )
            }
            <div>
              <h3 class="month-item-title">
                <a href={`/events/${event.id}/`}>{event.title}</a>
              </h3>
              <p class="signup-status" role="status">{signup.status}</p>
              <p class="month-when">{formatEventDate(event.date)}{time && `　${time}`}</p>
              {event.venue && <p>{event.venue}</p>}
              {event.price && <p class="month-price">{event.price}</p>}
              <SignupActions event={event} />
            </div>
          </article>
        );
      })
    )
  }
</section>
