---
import Icon from './Icon.astro';
import { formatEventDate, formatTimeRange, isPastEvent } from '../lib/classify.mjs';
import {
  buildMonthGrid,
  eventsInMonth,
  monthHref,
  monthKey,
  shiftMonth,
  shortEventName,
} from '../lib/calendar.mjs';
import { loadSite } from '../lib/load';
import type { WorkshopEvent } from '../lib/types';

interface Props {
  events: WorkshopEvent[];
  today: string;
  year: number;
  month: number;
}

const { events, today, year, month } = Astro.props;
const site = loadSite();
const key = monthKey(year, month);
const monthEvents = eventsInMonth(events, key) as WorkshopEvent[];
const grid = buildMonthGrid(year, month);
const weeks: (number | null)[][] = [];
for (let index = 0; index < grid.length; index += 7) weeks.push(grid.slice(index, index + 7));
const byDay = new Map<number, WorkshopEvent[]>();
for (const event of monthEvents) {
  const day = Number(event.date.slice(8, 10));
  const list = byDay.get(day) ?? [];
  list.push(event);
  byDay.set(day, list);
}
const todayDay = today.startsWith(`${key}-`) ? Number(today.slice(8, 10)) : 0;
const weekdays = ['日', '一', '二', '三', '四', '五', '六'];
const prev = shiftMonth(year, month, -1);
const next = shiftMonth(year, month, 1);
const pillInk = '#1A1A1A';
---

<section class="stamp calendar-card" aria-label={`${year}年${month}月`}>
  <div class="month-bar">
    <a class="month-switch" href={monthHref(monthKey(prev.year, prev.month))} aria-label="上個月">
      <Icon name="caret-left" />
    </a>
    <h2>{year}年{month}月</h2>
    <a class="month-switch" href={monthHref(monthKey(next.year, next.month))} aria-label="下個月">
      <Icon name="caret-right" />
    </a>
  </div>
  <table class="cal">
    <thead>
      <tr>
        {weekdays.map((label) => <th scope="col">{label}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        weeks.map((week) => (
          <tr>
            {week.map((day) => {
              const dayEvents = day ? (byDay.get(day) ?? []) : [];
              return (
                <td>
                  {day && dayEvents.length === 1 && (
                    <a
                      class:list={['cal-day', { 'is-today': day === todayDay }]}
                      href={`#${dayEvents[0].id}`}
                    >
                      <span class="cal-num">
                        {day}
                        {day === todayDay && <span class="sr-only">（今天）</span>}
                      </span>
                      <span class="cal-mark">
                        <span
                          class="cal-pill"
                          style={`background:${dayEvents[0].accentColor || 'var(--color-sage)'};color:${pillInk}`}
                        >
                          {shortEventName(dayEvents[0].title)}
                        </span>
                        <span
                          class="cal-dot"
                          style={`background:${dayEvents[0].accentColor || 'var(--color-sage)'}`}
                          aria-hidden="true"
                        />
                        <span class="sr-only">到下面的活動</span>
                      </span>
                    </a>
                  )}
                  {day && dayEvents.length !== 1 && (
                    <div class:list={['cal-day', { 'is-today': day === todayDay }]}>
                      <span class="cal-num">
                        {day}
                        {day === todayDay && <span class="sr-only">（今天）</span>}
                      </span>
                      {dayEvents.map((event) => (
                        <a class="cal-mark" href={`#${event.id}`}>
                          <span
                            class="cal-pill"
                            style={`background:${event.accentColor || 'var(--color-sage)'};color:${pillInk}`}
                          >
                            {shortEventName(event.title)}
                          </span>
                          <span
                            class="cal-dot"
                            style={`background:${event.accentColor || 'var(--color-sage)'}`}
                            aria-hidden="true"
                          />
                          <span class="sr-only">{shortEventName(event.title)}，到下面的活動</span>
                        </a>
                      ))}
                    </div>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</section>

<section class="month-list" aria-labelledby="month-list-title">
  <div class="section-head">
    <h2 id="month-list-title">本月活動</h2>
  </div>
  {
    monthEvents.length === 0 ? (
      <p class="empty">這個月還沒有安排活動。</p>
    ) : (
      monthEvents.map((event) => {
        const past = isPastEvent(event.date, today);
        const time = formatTimeRange(event.startTime, event.endTime);
        const [, monthNumber, dayNumber] = event.date.split('-');
        return (
          <article class="month-item" id={event.id}>
            <div class="stamp date-stamp" aria-hidden="true">
              <span class="date-stamp-mon">{Number(monthNumber)}月</span>
              <span class="date-stamp-day">{Number(dayNumber)}</span>
            </div>
            <div>
              <h3 class="month-item-title">{event.title}</h3>
              <p class="month-when">{formatEventDate(event.date)}{time && `　${time}`}</p>
              {event.venue && <p>{event.venue}</p>}
              {event.price && <p class="month-price">{event.price}</p>}
              <div class="event-actions">
                {past ? (
                  <p class="past-mark">已結束</p>
                ) : event.registrationUrl ? (
                  <a class="button" href={event.registrationUrl} target="_blank" rel="noopener noreferrer">
                    報名
                    <span class="sr-only">（在新視窗開啟報名表）</span>
                  </a>
                ) : (
                  <p class="pending" role="status">報名即將開放</p>
                )}
                {!past && site.lineUrl && (
                  <a
                    class:list={[event.registrationUrl ? 'button-ghost' : 'button']}
                    href={site.lineUrl}
                    rel="noopener noreferrer"
                  >
                    LINE 詢問
                    {site.lineId && <span class="line-id">{site.lineId}</span>}
                  </a>
                )}
              </div>
            </div>
          </article>
        );
      })
    )
  }
</section>
