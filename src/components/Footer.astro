---
interface Props {
  wordmark: string;
  name: string;
  nameZh: string;
  tagline: string;
  instagram: string;
  instagramHandle: string;
  xUrl: string;
  xHandle: string;
}

const { wordmark, name, nameZh, tagline, instagram, instagramHandle, xUrl, xHandle } = Astro.props;
const year = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Taipei',
  year: 'numeric',
}).format(new Date());
---

<footer class="site-footer">
  <div class="wrap">
    <div class="stamp footer-card">
      <div class="footer-grid">
        <div>
          <p class="wordmark" translate="no">{wordmark}</p>
          <p class="brand-zh">{nameZh}</p>
          <p class="footer-place">台北</p>
        </div>
        <p class="footer-tagline">{tagline}</p>
        <ul class="footer-links">
          <li>
            <a href={instagram} rel="noopener noreferrer">Instagram @{instagramHandle}</a>
          </li>
          {
            xUrl && (
              <li>
                <a href={xUrl} rel="noopener noreferrer">
                  X @{xHandle}
                </a>
              </li>
            )
          }
        </ul>
      </div>
      <p class="copyright">© {year} {name}</p>
    </div>
  </div>
</footer>
