---
import Icon from './Icon.astro';

interface Props {
  wordmark: string;
  nameZh: string;
  current: string;
}

const { wordmark, nameZh, current } = Astro.props;

const items: { href: string; label: string; icon?: 'calendar-blank' | 'newspaper' }[] = [
  { href: '/', label: '首頁' },
  { href: '/events', label: '月曆', icon: 'calendar-blank' },
  { href: '/news', label: '最新消息', icon: 'newspaper' },
  { href: '/experiences', label: '課程與體驗' },
  { href: '/recaps', label: '活動紀錄' },
  { href: '/about', label: '關於' },
];

function isCurrent(href: string) {
  if (href === '/') return current === '/';
  return current === href || current.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="wrap header-bar">
    <a class="brand" href="/">
      <img src="/brand/stamp.png" width="552" height="714" alt="" />
      <span class="brand-name">
        <span class="wordmark" translate="no">{wordmark}</span>
        <span class="brand-zh">{nameZh}</span>
      </span>
    </a>
    <details class="menu">
      <summary class="menu-button" aria-label="選單">
        <Icon name="list" class="icon-list" />
        <Icon name="x" class="icon-close" />
      </summary>
      <nav aria-label="主要">
        <ul>
          {
            items.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.icon && <Icon name={item.icon} />}
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
